# Gatecache Environment Configuration
# Copy this file to .env and configure as needed

# Upstream LLM/AI server URL
UPSTREAM_URL=http://localhost:8080

# Semantic cache similarity threshold (0.0 - 1.0)
# Requests with cosine similarity above this value will be served from cache
CACHE_SIMILARITY_THRESHOLD=0.85

# Cache entry TTL in seconds (default: 1 hour)
CACHE_TTL_SECS=3600

# Rate limiting: max requests per window per client IP
RATE_LIMIT_MAX_REQUESTS=60

# Rate limiting: window duration in milliseconds (default: 60 seconds)
RATE_LIMIT_WINDOW_MS=60000

# Maximum allowed prompt length in characters
MAX_PROMPT_LENGTH=10000

# Logging level (error, warn, info, debug, trace)
RUST_LOG=info
